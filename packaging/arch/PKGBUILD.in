# Rendered by .github/workflows/release.yml; placeholders are filled per release.
pkgname=henesys
pkgver=@PKGVER@
pkgrel=1
_ver=@VER@
pkgdesc="Makes heavy commands on a shared machine wait their turn, and says what they are waiting behind."
arch=(x86_64 aarch64)
url=https://github.com/Vusys/henesys
license=(MIT)
source_x86_64=("https://github.com/Vusys/henesys/releases/download/v${_ver}/henesys-${_ver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/Vusys/henesys/releases/download/v${_ver}/henesys-${_ver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  install -Dm755 henesys "$pkgdir/usr/bin/henesys"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
