# Rendered by .github/workflows/release.yml into Formula/henesys.rb on the master branch.
class Henesys < Formula
  desc "Makes heavy commands on a shared machine wait their turn, and says what they are waiting behind."
  homepage "https://github.com/Vusys/henesys"
  version "@VER@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/Vusys/henesys/releases/download/v@VER@/henesys-@VER@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/Vusys/henesys/releases/download/v@VER@/henesys-@VER@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_X86_64@"
    end
  end

  def install
    bin.install "henesys"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/henesys --version")
  end
end
